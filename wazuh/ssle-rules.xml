<!-- SSLE access log verification rules (JSON logs from /var/log/ssle/access.log). -->
<group name="ssle,">

  <!-- every logged request: proves the log, agent and manager pipeline works -->
  <rule id="100200" level="3">
    <decoded_as>json</decoded_as>
    <field name="service">\.+</field>
    <field name="srcip">\.+</field>
    <description>SSLE access log: $(service) $(method) $(path) returned $(status) to $(srcip)</description>
  </rule>

  <!-- a service answered with a client error (bad input, unknown route) -->
  <rule id="100202" level="4">
    <if_sid>100200</if_sid>
    <field name="status">^4\d\d$</field>
    <description>SSLE: $(service) rejected a request from $(srcip) (HTTP $(status))</description>
  </rule>

  <!-- a service failed (for example ingestion cannot reach storage) -->
  <rule id="100201" level="7">
    <if_sid>100200</if_sid>
    <field name="status">^5\d\d$</field>
    <description>SSLE: $(service) returned HTTP $(status) to $(srcip)</description>
  </rule>

</group>
